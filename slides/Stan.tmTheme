<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Stan</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#24292e</string>
        <key>background</key>
        <string>#ffffff</string>
      </dict>
    </dict>

    <!-- comments -->
    <dict>
      <key>scope</key>
      <string>comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#8a8a8a</string>
      </dict>
    </dict>

    <!-- strings -->
    <dict>
      <key>scope</key>
      <string>string</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#298e0d</string>
      </dict>
    </dict>

    <!-- numbers -->
    <dict>
      <key>scope</key>
      <string>constant.numeric</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#b60157</string>
      </dict>
    </dict>

    <!-- block names (data, model, ...), lower/upper, target += : red -->
    <dict>
      <key>scope</key>
      <string>keyword.other</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#d73a49</string>
      </dict>
    </dict>

    <!-- for, if, while, return, ... : purple -->
    <dict>
      <key>scope</key>
      <string>keyword.control</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#6f42c1</string>
      </dict>
    </dict>

    <!-- types (int, real, vector, ...) : teal -->
    <dict>
      <key>scope</key>
      <string>storage.type</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#0e7c86</string>
      </dict>
    </dict>

    <!-- operators (&lt;, &gt;, ~, +, ...) : orange -->
    <dict>
      <key>scope</key>
      <string>keyword.operator</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#e36209</string>
      </dict>
    </dict>

    <!-- built-in functions and distributions : blue -->
    <dict>
      <key>scope</key>
      <string>support.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#4b69c6</string>
      </dict>
    </dict>

    <!-- user-defined function calls -->
    <dict>
      <key>scope</key>
      <string>variable.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#005cc5</string>
      </dict>
    </dict>

    <!-- deprecated -->
    <dict>
      <key>scope</key>
      <string>invalid.deprecated</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#b08800</string>
        <key>fontStyle</key>
        <string>italic</string>
      </dict>
    </dict>

    <!-- illegal -->
    <dict>
      <key>scope</key>
      <string>invalid.illegal</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#cb2431</string>
        <key>fontStyle</key>
        <string>underline</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
